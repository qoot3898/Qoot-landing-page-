# Example production configuration for the Qoot API, as environment variables.
# Copy the names into IIS (Configuration Editor > environmentVariables), a systemd unit, a container
# definition or your secret store. Never commit real values. Double underscore = nested key.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5080

# --- database (required) --------------------------------------------------------------
ConnectionStrings__Qoot=Server=YOUR-SQL-SERVER;Database=Qoot;User Id=qoot_app;Password=CHANGE-ME;Encrypt=True;TrustServerCertificate=False
Database__ApplyMigrationsOnStartup=false

# --- security ---------------------------------------------------------------------------
Security__EnforceHttps=true
# behind nginx / a load balancer on the same machine:
Security__UseForwardedHeaders=false
# Security__KnownProxies__0=127.0.0.1
# only if the website is hosted on another origin than the API:
# Security__AllowedOrigins__0=https://www.qoot.com
# Security__CookieSameSite=None

# --- storage (persistent, backed up) ----------------------------------------------------
Media__RootPath=App_Data/media
DataProtection__KeysPath=App_Data/keys

# --- e-mail for new quote requests (optional) ------------------------------------------
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=
Smtp__Security=StartTls
Smtp__DashboardUrl=https://www.qoot.com/admin

# --- first administrator (prefer: dotnet Qoot.Api.dll create-admin --email ...) ----------
# Bootstrap__AdminEmail=
# Bootstrap__AdminPassword=

# --- API documentation (keep off in production) ----------------------------------------
OpenApi__Enabled=false
