  "how": {
    "title": {
      "ar": "طريقة عملنا",
      "en": "How we work"
    },
    "intro": {
      "ar": "من المورّد إلى بابك، نتولّى كل خطوة بأنفسنا.",
      "en": "From the supplier to your door, we handle every step ourselves."
    },
    "steps": [
      {
        "id": "step030",
        "hidden": false,
        "title": {
          "ar": "نورّد",
          "en": "Source"
        },
        "text": {
          "ar": "من مزارع وموردين نعرفهم، ونفحص كل شحنة قبل استلامها.",
          "en": "From farms and importers we know. Every delivery is checked at our door."
        },
        "tone": "leaf",
        "image": "$media:produce",
        "focusX": 30,
        "focusY": 50
      },
      {
        "id": "step031",
        "hidden": false,
        "title": {
          "ar": "نخزّن",
          "en": "Store"
        },
        "text": {
          "ar": "مستودعنا في بنغازي يفصل الجاف عن المبرّد والمجمّد، ويُصرف الأقدم أولًا.",
          "en": "Our Benghazi warehouse keeps dry, chilled and frozen apart, oldest out first."
        },
        "tone": "green",
        "image": "$media:warehouse",
        "focusX": 50,
        "focusY": 50
      },
      {
        "id": "step032",
        "hidden": false,
        "title": {
          "ar": "نطبخ",
          "en": "Cook"
        },
        "text": {
          "ar": "وجبات يومية للشركات والمواقع والمناسبات، في أوعية قوت المغلقة.",
          "en": "Daily meals for canteens, site camps and events, sealed in Qoot bowls."
        },
        "tone": "ochre",
        "image": "$media:meals",
        "focusX": 62,
        "focusY": 60
      },
      {
        "id": "step033",
        "hidden": false,
        "title": {
          "ar": "نوصّل",
          "en": "Deliver"
        },
        "text": {
          "ar": "يوميًا داخل بنغازي، وبجدول ثابت إلى المدن والمواقع في كل ليبيا.",
          "en": "Daily in Benghazi, and on a fixed schedule to cities and sites across Libya."
        },
        "tone": "sea",
        "image": "$media:truck",
        "focusX": 50,
        "focusY": 56
      }
    ]
  },
