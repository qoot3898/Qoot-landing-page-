# Where the browser finds the API. Leave empty when the API serves this website (one origin, recommended).
# Set it only when the site is hosted elsewhere, e.g. https://api.qoot.com (then add this site's origin to
# the API's Security:AllowedOrigins and set Security:CookieSameSite=None).
VITE_API_BASE_URL=

# Development only: where `npm run dev` proxies /api and /media.
QOOT_DEV_API=http://localhost:5080
