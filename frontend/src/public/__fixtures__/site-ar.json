-warehouse-stock-960.webp 960w, /assets/img/qoot-warehouse-stock-1600.webp 1600w"}]},"focusX":50,"focusY":50,"id":"step031"},{"title":"نطبخ","text":"وجبات يومية للشركات والمواقع والمناسبات، في أوعية قوت المغلقة.","tone":"ochre","image":{"id":4,"url":"/assets/img/qoot-meal-bowls-960.webp","type":"image/webp","width":5817,"height":3878,"alt":"وجبتان مطبوختان في أوعية قوت المغلقة","sources":[{"type":"image/avif","srcset":"/assets/img/qoot-meal-bowls-640.avif 640w, /assets/img/qoot-meal-bowls-960.avif 960w, /assets/img/qoot-meal-bowls-1600.avif 1600w, /assets/img/qoot-meal-bowls-2400.avif 2400w"},{"type":"image/webp","srcset":"/assets/img/qoot-meal-bowls-640.webp 640w, /assets/img/qoot-meal-bowls-960.webp 960w, /assets/img/qoot-meal-bowls-1600.webp 1600w, /assets/img/qoot-meal-bowls-2400.webp 2400w"}]},"focusX":62,"focusY":60,"id":"step032"},{"title":"نوصّل","text":"يوميًا داخل بنغازي، وبجدول ثابت إلى المدن والمواقع في كل ليبيا.","tone":"sea","image":{"id":7,"url":"/assets/img/qoot-delivery-truck-960.webp","type":"image/webp","width":1654,"height":976,"alt":"شاحنة توصيل قوت الخضراء برسوم الطعام على صندوقها","sources":[{"type":"image/avif","srcset":"/assets/img/qoot-delivery-truck-640.avif 640w, /assets/img/qoot-delivery-truck-960.avif 960w, /assets/img/qoot-delivery-truck-1654.avif 1654w"},{"type":"image/webp","srcset":"/assets/img/qoot-delivery-truck-640.webp 640w, /assets/img/qoot-delivery-truck-960.webp 960w, /assets/img/qoot-delivery-truck-1654.webp 1654w"}]},"focusX":50,"focusY":56,"id":"step033"}]}},{"key":"who","anchor":"who-we-feed","data":{"title":"من نخدم في ليبيا","lede":"مقرّنا في بنغازي، ونطبخ ونورّد للأماكن التي تُبقي ليبيا تعمل.","sectors":[{"label":"حقول النفط والغاز","icon":"oil","id":"sector034"},{"label":"مقاصف الشركات","icon":"canteen","id":"sector035"},{"label":"المستشفيات والعيادات","icon":"hospital","id":"sector036"},{"label":"المدارس والجامعات","icon":"school","id":"sector037"},{"label":"المطاعم والفنادق","icon":"restaurant","id":"sector038"},{"label":"الأعراس والمؤتمرات","icon":"events","id":"sector039"}],"meaningTitle":"معنى الاسم","meaningText":"القوت هو ما يحتاجه البيت من طعام في يومه. وقوت المدينة هو طعام المدينة اليومي.","mapIntro":"خريطة ليبيا: مقرّنا في بنغازي، ونوصّل إلى","hqLabel":"بنغازي","cities":[{"city":"tripoli","label":"طرابلس","showLabel":true,"id":"city040"},{"city":"misrata","label":"مصراتة","showLabel":true,"id":"city041"},{"city":"sirte","label":"سرت","showLabel":true,"id":"city042"},{"city":"raslanuf","label":"رأس لانوف","showLabel":true,"id":"city043"},{"city":"brega","label":"البريقة","showLabel":false,"id":"city044"},{"city":"ajdabiya","label":"أجدابيا","showLabel":true,"id":"city045"},{"city":"bayda","label":"البيضاء","showLabel":true,"id":"city046"},{"city":"derna","label":"درنة","showLabel":false,"id":"city047"},{"city":"tobruk","label":"طبرق","showLabel":true,"id":"city048"},{"city":"jalu","label":"جالو","showLabel":true,"id":"city049"},{"city":"kufra","label":"الكفرة","showLabel":true,"id":"city050"},{"city":"sabha","label":"سبها","showLabel":true,"id":"city051"},{"city":"ubari","label":"أوباري","showLabel":true,"id":"city052"},{"city":"ghat","label":"غات","showLabel":true,"id":"city053"}],"facts":[{"label":"مقرّنا","value":"بنغازي، ليبيا","id":"fact054"},{"label":"التوصيل","value":"يوميًا داخل بنغازي، وبجدول ثابت إلى كل ليبيا","id":"fact055"},{"label":"ساعات العمل","value":"السبت إلى الخميس، 8:00 – 17:00","id":"fact056"}],"ctaLabel":"تواصل معنا","ctaTarget":"#contact"}},{"key":"news","anchor":"news","data":{"title":"آخر الأخبار","intro":"ما يجري في قوت: عقود جديدة، مواسم التوريد، وما يتغير في طريقة عملنا.","homeCount":3,"viewAllLabel":"كل الأخبار","readMoreLabel":"اقرأ الخبر","emptyText":"لا توجد أخبار منشورة بعد. عد قريبًا.","hideWhenEmpty":true}},{"key":"faq","anchor":"faq","data":{"title":"أسئلة يطرحها عملاؤنا","sideTitle":"تحدّث معنا","items":[{"question":"إلى أي مناطق توصّلون؟","answer":"نوصّل داخل بنغازي يوميًا، ونصل إلى المدن ومواقع العمل في كل ليبيا بجدول ثابت، من طرابلس غربًا إلى طبرق شرقًا وسبها والكفرة جنوبًا. أخبرنا بموقعك لنؤكد موعد التوصيل.","id":"faq057"},{"question":"هل هناك حد أدنى للطلب؟","answer":"نعم، ويعتمد على مسافة التوصيل. تواصل معنا ونخبرك به بوضوح.","id":"faq058"},{"question":"هل كل اللحوم حلال؟","answer":"نعم. كل اللحوم والدواجن التي نورّدها أو نطبخها حلال، ونشارك شهادات الموردين عند الطلب.","id":"faq059"},{"question":"هل تطبخون لمناسبة واحدة؟","answer":"نعم. نطبخ للأعراس والمؤتمرات ومناسبات الشركات. أبلغنا قبل أسبوع على الأقل مع عدد الضيوف.","id":"faq060"},{"question":"هل يمكنكم إدارة المطبخ في مخيم موقعنا؟","answer":"نعم. نورّد المواد لمطبخكم فقط، أو نرسل طهاتنا لإدارته مع إعاشة كاملة.","id":"faq061"},{"question":"كيف تُسعَّر العقود؟","answer":"تُسعَّر الإعاشة بالفرد في اليوم، والتوريد حسب قائمة الأسعار. تواصل معنا ونرسل لك الأسعار مكتوبة خلال يومي عمل.","id":"faq062"}],"morePrefix":"لم تجد إجابتك؟","moreLinkLabel":"اسألنا على {email}"}},{"key":"contact","anchor":"contact","data":{"title":"تواصل معنا","sub":"اكتب لنا ما تحتاجه، وسنتصل بك خلال يومي عمل.","directLabel":"أو تواصل معنا مباشرة","whatsappLabel":"راسلنا على واتساب","image":{"id":1,"url":"/assets/img/qoot-oranges-sorting-line-930.webp","type":"image/webp","width":930,"height":860,"alt":"برتقال على خط الفرز قبل تعبئته","sources":[{"type":"image/avif","srcset":"/assets/img/qoot-oranges-sorting-line-640.avif 640w, /assets/img/qoot-oranges-sorting-line-930.avif 930w"},{"type":"image/webp","srcset":"/assets/img/qoot-oranges-sorting-line-640.webp 640w, /assets/img/qoot-oranges-sorting-line-930.webp 930w"}]},"nameLabel":"الاسم","namePlaceholder":"اسمك أو اسم الجهة","phoneLabel":"رقم الهاتف","phonePlaceholder":"091 234 5678","emailLabel":"البريد الإلكتروني","emailPlaceholder":"name@example.com","optionalLabel":"اختياري","messageLabel":"رسالتك","messagePlaceholder":"كيف يمكننا مساعدتك؟","submitLabel":"أرسل الرسالة","msgNameMissing":"اكتب اسمك لنعرف بمن نتصل.","msgPhoneInvalid":"اكتب رقم هاتف صحيحًا لنتصل بك.","msgEmailInvalid":"البريد الإلكتروني غير صحيح. صحّ